{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "types": [
            "vite/client",
            "node"
        ],
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "playwright.config.ts",
        "tests/browser/**/*.ts",
        "tests/frontend/**/*.ts",
        "vitest.config.ts"
    ]
}
