APP_NAME="Santa Shuffle"
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/database/database.sqlite
SESSION_SECURE_COOKIE=false
# Use smtp and a real sender before inviting anyone.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Santa Shuffle"
# Required only with compose.postgres.yaml. Choose a long random password.
POSTGRES_PASSWORD=
