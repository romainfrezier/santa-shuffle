{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "build": "vite build && node scripts/collect-licenses.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write resources/js resources/css tests/frontend tests/browser playwright.config.ts vitest.config.ts",
    "format:check": "prettier --check resources/js resources/css tests/frontend tests/browser playwright.config.ts vitest.config.ts",
    "test:e2e": "playwright test",
    "test:runtime": "php tests/Runtime/concurrency.php && php tests/Runtime/mail.php",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@inertiajs/vite": "^3.11.0",
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@inertiajs/react": "^3.11.0",
    "@radix-ui/react-select": "^2.4.1",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "name": "santa-shuffle"
}
